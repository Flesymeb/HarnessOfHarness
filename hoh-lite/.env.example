# Copy this file to `.env` and fill only local/private values.
# `.env` is ignored by git.

# Absolute path to this HoH-lite project root.
GAMELOOP_HOME=/absolute/path/to/hoh-lite

# External GameCraft-Bench checkout. Keep benchmark tasks, verifier, wrappers,
# and large jobs outside this GameLoop source tree.
GAMELOOP_BENCH=/absolute/path/to/gamecraft-bench
# Tracked changes and runtime-relevant untracked source/task/tool files are
# rejected by default for reproducibility. This escape hatch is only for local
# adapter development, never benchmark results.
# GAMELOOP_ALLOW_DIRTY_BENCH=1

# Default Harbor job artifact directory. Keep mutable outputs in Lite rather
# than writing into the external benchmark checkout.
GAMELOOP_JOBS_DIR=${GAMELOOP_HOME}/jobs/gameloop

# Local copied asset libraries. Run `./scripts/sync-assets /path/to/assets` (or
# export this file's GAMELOOP_BENCH value) to refresh them. The multi-GB payload
# is ignored by Git.
GAMELOOP_ASSETS_DIR=${GAMELOOP_HOME}/assets
GAMECRAFT_BENCH_ASSET_LIBRARY=${GAMELOOP_ASSETS_DIR}/library
GAMECRAFT_BENCH_OGA_LIBRARY=${GAMELOOP_ASSETS_DIR}/library-oga
GAMECRAFT_BENCH_ASSET_LIBRARY_MOUNTPOINT=/workspace/assets/library
GAMECRAFT_BENCH_OGA_LIBRARY_MOUNTPOINT=/workspace/assets/library-oga

# Optional additional env file loaded after GameCraft-Bench .env and this file.
# GAMELOOP_ENV_FILE=/absolute/path/to/private.env

# Godot / runner tools.
GAMECRAFT_BENCH_GODOT_BIN=godot
GAMELOOP_GODOT_EDITOR_BIN=godot
# Limit each long-lived Runtime-owned MCP editor/game process tree on Linux.
# Set 0 to disable CPU affinity; verifier replay processes are unaffected.
GAMELOOP_GODOT_MAX_CPUS=4
# Trusted-host escape hatch for machines where bwrap user namespaces are
# disabled. Tester still receives a sanitized candidate copy, but can see the
# host filesystem, so never enable this on an untrusted or shared runner.
# Backend selection is auto -> namespace -> bwrap -> explicitly allowed direct.
# GAMELOOP_GAMECRAFT_BACKEND=auto
GAMELOOP_GAMECRAFT_ALLOW_DIRECT_BACKEND=0
GAMELOOP_TESTER_ALLOW_UNISOLATED=0
# Runtime bounds each editor bridge startup and retries it once on failure.
# After a cold Developer creates project.godot, the first candidate-bound MCP
# call waits up to this startup window while Runtime launches the editor.
GAMELOOP_GODOT_MCP_STARTUP_TIMEOUT_SECONDS=45
# Extracted official Godot documentation; queried offline by all three roles.
# GAMELOOP_GODOT_DOCS_ROOT=/absolute/path/to/godot-docs-html
# Lite-launched MCP servers set this to 1 by default, hiding MCP's open-world
# network documentation tool while retaining all candidate-bound tools.
# GAMELOOP_GODOT_MCP_OFFLINE_ONLY=1
GODOT_SILENCE_ROOT_WARNING=1
GAMECRAFT_BENCH_PYTEST_BIN=pytest

# Use local Codex login by default for agent and judge calls.
# The runner also sets codex-cli judge vars when --codex-login is enabled.
# Optional explicit account; otherwise the active ~/.codex login is preferred
# before the legacy ~/.codex-judge-login fallback.
# GAMELOOP_LOCAL_CODEX_HOME=/absolute/path/to/.codex
GAMECRAFT_BENCH_JUDGE_MODEL=gpt-5.5

# Optional provider harness routes. Keep real keys in .env or a private env file.
# BAILIAN_API_KEY=
# BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PJLAB_API_KEY=
# PJLAB_API_KEY_FILE=${HOME}/.config/gameloop/secrets/pjlab_api_key
# PJLAB_BASE_URL=https://api.pjlab.org.cn/v1

# DeepSeek Harness Python SDK standalone minimal preset.
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEY_FILE=${HOME}/.config/gameloop/secrets/pjlab_api_key
# DEEPSEEK_BASE_URL=https://api.pjlab.org.cn/v1
# Required acknowledgement: the official standalone minimal composition uses
# danger-full-access. Set only inside an outer sandbox or on a trusted host.
# GAMELOOP_DSH_ALLOW_DANGER_FULL_ACCESS=1

# If you intentionally use API-key/proxy mode, set these locally.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# GAMECRAFT_BENCH_JUDGE=openai-responses
# GAMECRAFT_BENCH_JUDGE_OPENAI_API_KEY=
# GAMECRAFT_BENCH_JUDGE_OPENAI_BASE_URL=
# GAMECRAFT_BENCH_JUDGE_RESPONSES_REASONING_EFFORT=high
# GAMECRAFT_BENCH_JUDGE_RESPONSES_TIMEOUT=300
# GAMECRAFT_BENCH_JUDGE_CALL_TIMEOUT_SECONDS=420
