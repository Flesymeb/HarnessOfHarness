+	print("1..1")
+	if passed:
+		print("ok 1 - debugger break is a typed non-transport product diagnostic")
+		quit(0)
+	else:
+		printerr("not ok 1 - unexpected debugger break payload: %s" % str(result))
+		quit(1)
